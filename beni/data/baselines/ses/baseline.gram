# Songhay (Koyra Chiini / SES) morphotactic patterns
# macro definitions
macro   @v@             <re>[aoeiu]</re>
macro   @cons@          <re>[bcdfghjklmŋprstwy]</re>
macro   @ses-cons@      [bcdfghjklmŋprstwy]
macro   @syl@           [^aoeiu]*(?P<V>[aoeiu])(?P=V)?

# processing instructions
plan
for token:
stage 0 add parallel parse inflection
stage 0 add parallel parse common_derivation
stage 0 apply lookup
return if parsed
stage 1 add sequential parse n_v_derivation
stage 1 add parallel parse n_derivation
stage 1 add parallel parse v_vq_derivation
stage 1 add parallel parse vq_derivation
stage 1 add parallel parse num_derivation
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
return if parsed
stage 4 apply firstmatch parse nonSES
return if parsed

#for sentence
section inflection
# nominal inflection
# Plural markers: -y (after vowel), -ey (after consonant)
# e.g., alaaya -> alaayaney, booro -> borey, haya -> hayey, konda -> kondawey
pattern :n/adj/prn/n.prop/num: [ {@v@|y}:: ] | :n/adj/prn/n.prop/num: [:n/adj/prn/n.prop/num: :mrph:PL]
pattern :n/adj/prn/n.prop/num: [ {@cons@|ey}:: ] | :n/adj/prn/n.prop/num: [:n/adj/prn/n.prop/num: :mrph:PL]

# Definite article / Specificity: -oo / -aa
# e.g., hugu -> hugoo, ašarya -> ašaryaa, ganda -> gandaa
pattern :n: [ {|oo}:: ] | :n: [:n: :mrph:DEF]
pattern :n: [ {|aa}:: ] | :n: [:n: :mrph:DEF]

# derivative forms we need to consider even if we have them in dictionary
section common_derivation
# -yan / -yaa / -yandey ABSTR / ADJ (e.g., borocinitaray, tenjeyanoo, fasalyanoo)
pattern :n/adj/v: [ {|yan}:: ] | :n: [:n/adj/v: :mrph:ABSTR]
pattern :n/adj/v: [ {|yaa}:: ] | :n: [:n/adj/v: :mrph:ABSTR]
pattern :n/adj/v: [ {|yandey}:: ] | :n: [:n/adj/v: :mrph:ABSTR :mrph:PL]

# common nominal/verbal derivation (locatives/relational)
section n_v_derivation
# Postpositions acting as relational/locative clitics
# e.g., hugu ra (in the house), ganda do (to the country), boro se (for the person)
pattern :n/n.prop: [ {|ra}:: ] | :n/n.prop: [:n/n.prop: :mrph:LOC]
pattern :n/n.prop: [ {|do}:: ] | :n/n.prop: [:n/n.prop: :mrph:ALL]
pattern :n/n.prop: [ {|se}:: ] | :n/n.prop: [:n/n.prop: :mrph:DAT]
pattern :n/n.prop: [ {|ga}:: ] | :n/n.prop: [:n/n.prop: :mrph:ABL]

# nominal derivation
section n_derivation
# -koy / -kaw AG (agent/occupation, e.g., goykoy, hantumkaw)
pattern :n: [ {|koy}:: ] | :n: [ :v/n: :mrph:AG]
pattern :n: [ {|kaw}:: ] | :n: [ :v/n: :mrph:AG]
# -boobo AUGM
pattern :n/adj: [ {|boobo}:: ] | :n/adj: [:n/adj: :mrph:AUGM]
# -kayna DIM
pattern :n/adj: [ {|kayna}:: ] | :n/adj: [:n/adj: :mrph:DIM]

# verbal/vq derivation
section v_vq_derivation
# -andi / -tandi CAUS (e.g., bayrandi, gaaranti, kayandi, tabatandi)
pattern :v: [ {|andi}:: ] | :v: [ :v: :mrph:CAUS]
pattern :v: [ {|tandi}:: ] | :v: [ :v: :mrph:CAUS]
# -yan NMLZ (verbal noun, e.g., tenjeyanoo)
pattern :n: [ {|yan}:: ] | :n: [ :v: :mrph:NMLZ]

# vq derivation
section vq_derivation
pattern :vq: [ {|ya}:: ] | :n/v: [ :vq: :mrph:DEQU]
pattern :adj: [ {|man}:: ] | :adj: [ :vq: :mrph:ADJ]

# numeral derivation
section num_derivation
pattern :num: [ {|yandey}:: ] | :num: [ :num: :mrph:DISTR]

## reduplication
section reduplication
pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :num: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :num: [ :num: :num: ]
pattern :v: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :v: [ :v: :: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :: :adj: ]
pattern :num: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :num: [ :num: :: :num: ]

## composition
# general part-of-speech composition patterns
section pos_composition

# two-words composites
# n.prop + n = n   ex: Mali ganda
pattern :n: [ :n.prop: :n: ] | :n: [ :n.prop: :n: ]
# v/n + n = n   ex: goykoy, hantumkaw
pattern :n: [ :n/v: :n: ] | :n: [ :n/v: :n: ]
# n + v = n/v
pattern :n/v: [ :n: :v: ] | :n/v: [ :n: :v: ]
# n + adj/num = n
pattern :n: [ :n: :adj/num: ] | :n: [ :n: :adj/num: ]
# dtm + v = n
pattern :n: [ :dtm: :v: ] | :n: [ :dtm: :v: ]
# pp + n = n
pattern :n: [ :pp: :n: ] | :n: [ :pp: :n: ]

# three-words composites
# n + adj/pp/num + n = n
pattern :n: [ :n: :adj/pp/num: :n: ] | :n: [ :n: :adj/pp/num: :n: ]
# dtm/n + v + n = n
pattern :n: [ :dtm/n: :v: :n: ] | :n: [ :dtm/n: :v: :n: ]
# n + pp + v = n/v
pattern :n/v: [ :n: :pp: :v: ] | :n/v: [ :n: :pp: :v: ]
# n+n+n = n
pattern :n: [ :n: :n: :n: ] | :n: [ :n: :n: :n: ]

# v+mrph+n  ex: bayrandi, gaaranti
pattern :n: [ :v: andi:mrph: :n: ] | :n: [ :v: :mrph:CAUS :n: ]
pattern :n: [ :v: tandi:mrph: :n: ] | :n: [ :v: :mrph:CAUS :n: ]

# v+mrph+v
pattern :v: [ :v: andi:mrph: :v: ] | :v: [ :v: :mrph:CAUS :v: ]

# four-words composites
# n + pp + n + n = n
pattern :n: [ :n: :pp: :n: :n: ] | :n: [ :n: :pp: :n: :n: ]
# n + pp + adj + n = n
pattern :n: [ :n: :pp: :adj: :n: ] | :n: [ :n: :pp: :adj: :n: ]
# n+v+v+n
pattern :n: [ :n: :v: :v: :n: ] | :n: [ :n: :v: :v: :n: ]

# orthographically unlikely to be songhay words
# for NEW orthography, with no tones marked
section nonSES
# forms with symbols out of songhay alphabet
pattern <re>.*[qxçäëïüâêîôûéùàøðþ].*</re>:: | ::EMPR
# two different vowels in sequence (no diphthongs in standard Koyra Chiini)
pattern <re>.*(?P<v>[aoeiu])(?!(?P=v))(?=[aoeiu]).*</re>:: | ::EMPR