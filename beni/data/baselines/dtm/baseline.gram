# Dogon morphotactic patterns

# macro definitions
macro   @vow@            [aeiouɛɔ]
macro   @cons@           [bcɗfghjklmnɲŋprstwwyz]
macro   @syl@            [^aeiouɛɔ]*(?P<V>[aeiouɛɔ])(?P=V)?([^aeiouɛɔ]+(?=([^aeiouɛɔ]|$)))?

# processing instructions
plan
for token:
stage 0 add parallel parse noun_inflection
stage 0 add parallel parse verb_inflection
stage 0 apply lookup
return if parsed
stage 1 add sequential parse verbal_derivation
stage 1 add parallel parse nominal_derivation
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
return if parsed
stage 4 apply firstmatch parse nondogon
return if parsed

# --- NOUN INFLECTION (Noun Class Suffixes and Pluralization) ---
section noun_inflection

# Plural Noun Classes (-w, -be, -nw)
pattern :n: [ {|w}:: ] | :n: [ :n: :mrph:PL ]
pattern :n: [ {|be}:: ] | :n: [ :n: :mrph:PL.REL ]
pattern :n: [ {|nw}:: ] | :n: [ :n: :mrph:PL.ALT ]

# Singular Noun Class (often implicit)

# Diminutive (-i, -ii)
pattern :n: [ {|i}:: ] | :n: [ :n: :mrph:DIM ]
pattern :n: [ {|ii}:: ] | :n: [ :n: :mrph:DIM.ALT ]

# --- VERBAL INFLECTION (Aspect, Voice, & Tense Markers) ---
section verb_inflection

# Active Voice Suffixes
pattern :v: [ {|i}:: ] | :v: [ :v: :mrph:PFV ]
pattern :v: [ {|l}:: ] | :v: [ :v: :mrph:PFV.NEG ]
pattern :v: [ {|a}:: ] | :v: [ :v: :mrph:IPFV ]
pattern :v: [ {|le}:: ] | :v: [ :v: :mrph:IPFV.NEG ]
pattern :v: [ {|u}:: ] | :v: [ :v: :mrph:IMP ]
pattern :v: [ {|do}:: ] | :v: [ :v: :mrph:FUT ]
pattern :v: [ {|j}:: ] | :v: [ :v: :mrph:PROG ]

# Enclitic Verb Forms
pattern :v: [ {|m}:: ] | :v: [ :v: :mrph:PFV.1SG ]
pattern :v: [ {|u}:: ] | :v: [ :v: :mrph:PFV.2SG ]
pattern :v: [ {|w}:: ] | :v: [ :v: :mrph:PFV.1PL ]
pattern :v: [ {|be}:: ] | :v: [ :v: :mrph:PFV.2PL ]
pattern :v: [ {|w}:: ] | :v: [ :v: :mrph:PFV.3PL ]

# --- VERBAL DERIVATION (Derivational Extensions) ---
section verbal_derivation

# Extensions: Causative, Instrumental, Medio-passive, Reversive
pattern :v: [ {|m}:: ] | :v: [ :v: :mrph:CAUS ]
pattern :v: [ {|r}:: ] | :v: [ :v: :mrph:INST ]
pattern :v: [ {|y}:: ] | :v: [ :v: :mrph:MPASS ]
pattern :v: [ {|t}:: ] | :v: [ :v: :mrph:REVR ]

# Complex & Stacked Extensions
pattern :v: [ {|m|r}:: ] | :v: [ :v: :mrph:CAUS :mrph:INST ]
pattern :v: [ {|y|m}:: ] | :v: [ :v: :mrph:MPASS :mrph:CAUS ]
pattern :v: [ {|t|r}:: ] | :v: [ :v: :mrph:REVR :mrph:INST ]

# --- NOMINAL DERIVATION (Agentive & Abstract Derivations) ---
section nominal_derivation

# Agentive & Abstract Suffixes
pattern :n: [ {|n}:: ] | :n: [ :v: :mrph:AG.SG ]
pattern :n: [ {|nw}:: ] | :n: [ :v: :mrph:AG.PL ]
pattern :n: [ {|u}:: ] | :n: [ :v: :mrph:NMLZ ]
pattern :n: [ {|g}:: ] | :n: [ :n: :mrph:GENT ]
pattern :n: [ {|w}:: ] | :n: [ :n: :mrph:GENT.PL ]
pattern :n: [ {|ya}:: ] | :n: [ :n: :mrph:ABSTR ]

# --- REDUPLICATION ---
section reduplication

pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :n: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :n: [ :n: :n: ]

# --- POS COMPOSITION (Noun-Noun, Noun-Adj Compounding) ---
section pos_composition

# Two-word composites
pattern :n: [ :n: :n: ] | :n: [ :n: :n: ]
pattern :n: [ :n: :adj: ] | :n: [ :n: :adj: ]
pattern :n: [ :v: :n: ] | :n: [ :v: :n: ]
pattern :n: [ :n: :v: ] | :n: [ :n: :v: ]

# --- NON-DOGON FILTER ---
section nondogon

# Filter forms ending with non-Dogon orthographic sequences or invalid cluster characters
pattern <re>.*[qxzvvwxQXZVWX].*</re>:: | ::EMPR